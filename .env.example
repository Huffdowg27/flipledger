# FlipLedger environment variables.
#
# You usually don't need this file at all. All marketplace credentials are
# entered on the Settings page on first run and stored in the local SQLite
# database — NOT through environment variables. The only supported override
# is the port. Copy this file to `.env.local` if you want to set it.

# Override the default port (default: 3000)
# PORT=3000

# ── Marketplace credentials ─────────────────────────────────────────────────
# Do NOT set these here — the app does not read marketplace credentials from
# the environment. Enter them on the Settings page after first launch (each
# marketplace section has a "Test Connection" button); they're saved to the
# database. You must register your own developer apps:
#   Amazon SP-API  → https://developer-docs.amazon.com/sp-api
#   Walmart API    → https://developer.walmart.com
#   eBay Developer → https://developer.ebay.com
